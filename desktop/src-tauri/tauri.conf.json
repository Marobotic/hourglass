{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hourglass",
  "version": "0.3.0",
  "identifier": "dev.marobotic.hourglass",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hourglass",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#121212",
        "dragDropEnabled": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Marobotic",
    "shortDescription": "Calendar, notes, alarms and timers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
